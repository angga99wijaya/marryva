NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Prefer the Supabase publishable key. The anon key is supported for legacy projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Prefer the new Supabase Secret API key; legacy service-role JWT is fallback only.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Required only for the additive MongoDB import.
MONGODB_URI=
MONGODB_DATABASE=
