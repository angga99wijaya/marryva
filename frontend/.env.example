NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side Google Gemini API access for the authenticated AI Planner.
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-2.5-flash
NEXT_PUBLIC_SUPABASE_URL=
# Prefer the Supabase publishable key. The anon key is supported for legacy projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Auth Admin invitation tooling requires a valid server-only service-role JWT.
SUPABASE_AUTH_ADMIN_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Required only for the additive MongoDB import.
MONGODB_URI=
MONGODB_DATABASE=
